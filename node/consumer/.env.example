# Copy to .env and fill in what the cluster owner sent you.
CVEC_BROKERS=host:port
CVEC_USERNAME=demo1
CVEC_PASSWORD=
# true only if you were given a TLS address
CVEC_SSL=false

# Optional defaults for the command-line flags (see: npm start -- --help)
# CVEC_SINCE=2026-11-16
# CVEC_TOPIC=cve.changes
# CVEC_OUT=~/Downloads/cvec-cves
